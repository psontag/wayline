{
  "name": "wayline",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "setup:worktree": "node scripts/setup-worktree.js",
    "worktree:prune": "node scripts/prune-worktrees.js",
    "build": "pnpm --filter @wayline/web build && pnpm --filter @wayline/api build",
    "lint": "eslint .",
    "typecheck": "pnpm --recursive typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data:build": "pipeline/build.sh",
    "report:trips": "vitest run --config packages/planner/report/vitest.config.ts --root . --disable-console-intercept",
    "bench": "vitest run --config packages/planner/bench/vitest.config.ts --root . --disable-console-intercept",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm format:check",
    "e2e": "playwright test",
    "test:pipeline": "cd pipeline && uvx ruff@0.17.2 check . && uv run --no-project -p 3.12 --with-requirements requirements.txt --with pytest==9.1.1 pytest tests -q"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.14.0",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
